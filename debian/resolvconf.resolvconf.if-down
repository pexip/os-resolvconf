#!/bin/sh
#
# ifdown hook script for resolvconf
#
# This file is part of the resolvconf package.
#

[ -x /usr/sbin/resolvconf ] || exit 0

case "$ADDRFAM" in
  inet|inet6) :      ;;
  *,*) ADDRFAM="$(echo $ADDRFAM | tr , '\n' | sort | head -n1)" ;;
  *)          exit 0 ;;
esac

/usr/sbin/resolvconf -d "${IFACE}.${ADDRFAM}" || :

